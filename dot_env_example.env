# Server: /root/shortterm_store/.env (read by docker compose)
SECRET_KEY=keep-the-current-production-key
DEBUG=False
ALLOWED_HOSTS=shortterm.store,new.shortterm.store
CSRF_TRUSTED_ORIGINS=https://shortterm.store,https://new.shortterm.store
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
STORAGE_DIR=/mnt/volume-ams3-01/shortterm_store/storage
# Hosts that get the redesigned page (default: both domains); set to new.shortterm.store to
# put shortterm.store back on the classic page.
# NEW_DESIGN_HOSTS=shortterm.store,new.shortterm.store
